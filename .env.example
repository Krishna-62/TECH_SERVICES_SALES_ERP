# Copy to .env (git-ignored). Server-side only — nothing here reaches the browser.

# This application's OWN PostgreSQL database. Never the Technicon Services ERP database.
# Local development: a local Postgres database. Production: a dedicated Supabase project.
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/technicon_sales_erp_dev

# Comma-separated origins allowed to call the API with credentials. Leave empty when the web app
# and API are served from the same origin (the default deployment).
CLIENT_ORIGIN=

PORT=4100

# Technicon Services ERP, read-only (Phase 3: companies and quotations). Not used yet.
ERP_API_URL=
