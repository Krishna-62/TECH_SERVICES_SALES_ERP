# Local, disposable PostgreSQL database for automated tests (`npm test`). Copy to .env.test
# (git-ignored). Must be on localhost and the database name must end in "_test" — every test run
# DROPS AND RECREATES its public schema. The database is created automatically if missing.
TEST_DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/technicon_sales_erp_test
